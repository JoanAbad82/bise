# the fields it carries come back (the others at their default)
law Out.journal_round_by_fields:
  for +xid: Nat
  for +project: String
  for +kind: S.XKind
  for +msg: Nat
  for +text: String
  for +st: S.OutSt
  for +tries: Nat
  for +context: String
  for +parts: String
  {Out.journal_of(Out.journal_json(S.Out{xid, project, kind, msg, text, st, tries, context, parts})) == S.Out{xid, project, kind, msg, text, st, tries, context, parts} : S.Out}

