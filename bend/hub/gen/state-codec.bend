      %skip_s("name", name, [K.flag("held", held)], "until_ms", {==}) : {K.opt_n(_) == None{} : Maybe<&2, Nat>}
      %skip_flag("held", held, [], "until_ms", {==}) : {K.opt_n(_) == None{} : Maybe<&2, Nat>}
