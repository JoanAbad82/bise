# ---- Route, its journal shape: rid, text, via, to, name, due_ms, act, why, state, context, parts ----

def Route.journal_kvs(r: S.Route) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Route{+rid, +text, +via, +to, +name, +due, +act, +why, +st, +context, +parts}:
      K.cat([[J.kv("rid", J.JNum{rid}), J.kv("text", J.JStr{text}), J.kv("via", J.JStr{via}), J.kv("to", J.JStr{to}), J.kv("name", J.JStr{name}), J.kv("due_ms", J.JNum{due}), J.kv("act", J.JNum{act}), J.kv("why", J.JStr{why}), J.kv("state", J.JStr{RSt.word(st)}), J.kv("context", J.JStr{context})], K.omit_s("parts", parts)])

def Route.journal_json(r: S.Route) -> J.Json:
  J.obj(Route.journal_kvs(r))

def Route.journal_of(+j: J.Json) -> S.Route:
  S.Route{rd.n(J.get(j, "rid")), rd.s(J.get(j, "text")), rd.s(J.get(j, "via")), rd.s(J.get(j, "to")), rd.s(J.get(j, "name")), rd.n(J.get(j, "due_ms")), rd.n(J.get(j, "act")), rd.s(J.get(j, "why")), RSt.of_word(rd.s(J.get(j, "state"))), rd.s(J.get(j, "context")), rd.s(J.get(j, "parts"))}

