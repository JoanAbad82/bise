# ---- Timer, its view shape: id, agent, by, text, every_ms, next_ms, fired, last_ms, runs, until_ms, times, page, name ----

def Timer.view_kvs(r: S.Timer) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Timer{+id, +agent, +by, +text, +sched, +next, +until, +times, +fired, +page, +last, +runs, +name, _}:
      K.cat([[J.kv("id", J.JNum{id}), J.kv("agent", J.JStr{agent}), J.kv("by", J.JStr{by}), J.kv("text", J.JStr{text})], [SH.sched_kv(sched)], [J.kv("next_ms", J.JNum{next}), J.kv("fired", J.JNum{fired}), J.kv("last_ms", J.JNum{last}), J.kv("runs", J.JArr{K.jnats(runs)})], K.omit_mn("until_ms", until), K.omit_mn("times", times), K.omit_ms("page", page), K.omit_s("name", name)])

def Timer.view_json(r: S.Timer) -> J.Json:
  J.obj(Timer.view_kvs(r))

# ---- TimerEnd, its view shape: t, ended_ms, why ----

def TimerEnd.view_kvs(r: S.TimerEnd) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.TimerEnd{+t, +at, +why}:
      K.cat([Timer.view_kvs(t), [J.kv("ended_ms", J.JNum{at}), J.kv("why", J.JStr{why})]])

def TimerEnd.view_json(r: S.TimerEnd) -> J.Json:
  J.obj(TimerEnd.view_kvs(r))

# ---- Act, its journal shape: id, due, what ----

def Act.journal_kvs(r: S.Act) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Act{+id, +due, +what}:
      [J.kv("id", J.JNum{id}), J.kv("due", J.JNum{due}), J.kv("what", What.json(what))]

def Act.journal_json(r: S.Act) -> J.Json:
  J.obj(Act.journal_kvs(r))

def Act.journal_of(+j: J.Json) -> S.Act:
  S.Act{rd.n(J.get(j, "id")), rd.n(J.get(j, "due")), What.of(rd.j(J.get(j, "what")))}

law Act.journal.id:
  for +id: Nat
  for +due: Nat
  for +what: S.What
  {rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "id")) == id : Nat}

def Act.journal.id(id, due, what):
  {==}

law Act.journal.due:
  for +id: Nat
  for +due: Nat
  for +what: S.What
  {rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "due")) == due : Nat}

def Act.journal.due(id, due, what):
  {==}

law Act.journal.what:
  for +id: Nat
  for +due: Nat
  for +what: S.What
  {What.of(rd.j(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "what"))) == what : S.What}

def Act.journal.what(id, due, what):
  What.round(what)

# the fields it carries come back (the others at their default)
law Act.journal_round_by_fields:
  for +id: Nat
  for +due: Nat
  for +what: S.What
  {Act.journal_of(Act.journal_json(S.Act{id, due, what})) == S.Act{id, due, what} : S.Act}

def Act.journal_round_by_fields(id, due, what):
  %Equal.sym(Nat, rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "id")), id, Act.journal.id(id, due, what)) : {S.Act{_, rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "due")), What.of(rd.j(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "what")))} == S.Act{id, due, what} : S.Act}
  %Equal.sym(Nat, rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "due")), due, Act.journal.due(id, due, what)) : {S.Act{id, _, What.of(rd.j(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "what")))} == S.Act{id, due, what} : S.Act}
  %Equal.sym(S.What, What.of(rd.j(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "what"))), what, Act.journal.what(id, due, what)) : {S.Act{id, due, _} == S.Act{id, due, what} : S.Act}
  {==}

law Act.journal_round:
  for x: S.Act
  {Act.journal_of(Act.journal_json(x)) == x : S.Act}

def Act.journal_round(x):
  match x:
    case S.Act{id, due, what}:
      Act.journal_round_by_fields(id, due, what)

# ---- Watch, its journal shape: id, agent, spec, max_text, set_at, max_at, quiet, resumes ----

def Watch.journal_kvs(r: S.Watch) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Watch{+id, +agent, +spec, +max_text, +set_at, +max_at, +quiet, +resumes}:
      [J.kv("id", J.JNum{id}), J.kv("agent", J.JStr{agent}), J.kv("spec", spec), J.kv("max_text", J.JStr{max_text}), J.kv("set_at", J.JNum{set_at}), J.kv("max_at", J.JNum{max_at}), J.kv("quiet", J.JBool{quiet}), J.kv("resumes", J.JBool{resumes})]

def Watch.journal_json(r: S.Watch) -> J.Json:
  J.obj(Watch.journal_kvs(r))

def Watch.journal_of(+j: J.Json) -> S.Watch:
  S.Watch{rd.n(J.get(j, "id")), rd.s(J.get(j, "agent")), rd.j(J.get(j, "spec")), rd.s(J.get(j, "max_text")), rd.n(J.get(j, "set_at")), rd.n(J.get(j, "max_at")), rd.b(J.get(j, "quiet")), SH.watch_resumes(J.get(j, "resumes"), J.get(j, "spec"))}

