# ---- Ans, its journal shape: said, pick_n, pick, via, page, block ----

def Ans.journal_kvs(r: S.Ans) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Ans{+said, +pick_n, +pick, +via, +page, +block}:
      K.cat([K.omit_s("said", said), K.omit_mn("pick_n", pick_n), K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)])

def Ans.journal_json(r: S.Ans) -> J.Json:
  J.obj(Ans.journal_kvs(r))

def Ans.journal_of(+j: J.Json) -> S.Ans:
  S.Ans{rd.s(J.get(j, "said")), K.opt_n(J.get(j, "pick_n")), rd.s(J.get(j, "pick")), rd.s(J.get(j, "via")), rd.s(J.get(j, "page")), rd.s(J.get(j, "block"))}

law Ans.journal.said:
  for +said: String
  for +pick_n: Maybe<&2, Nat>
  for +pick: String
  for +via: String
  for +page: String
  for +block: String
  {rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "said")) == said : String}

def Ans.journal.said(said, pick_n, pick, via, page, block):
  match said:
    case SNil{}:
      %skip_mn("pick_n", pick_n, [K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)], "said", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("pick", pick, [K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)], "said", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("via", via, [K.omit_s("page", page), K.omit_s("block", block)], "said", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("page", page, [K.omit_s("block", block)], "said", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("block", block, [], "said", {==}) : {rd.s(_) == SNil{} : String}
      {==}
    case SCon{said_h, said_t}:
      {==}

law Ans.journal.pick_n:
  for +said: String
  for +pick_n: Maybe<&2, Nat>
  for +pick: String
  for +via: String
  for +page: String
  for +block: String
  {K.opt_n(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "pick_n")) == pick_n : Maybe<&2, Nat>}

def Ans.journal.pick_n(said, pick_n, pick, via, page, block):
