  {==}

law Watch.journal_round:
  for x: S.Watch
  {Watch.journal_of(Watch.journal_json(x)) == x : S.Watch}

def Watch.journal_round(x):
  match x:
    case S.Watch{id, agent, spec, max_text, set_at, max_at, quiet, resumes}:
      Watch.journal_round_by_fields(id, agent, spec, max_text, set_at, max_at, quiet, resumes)

# ---- WatchEnd, its view shape: w, ended_at, why ----

def WatchEnd.view_kvs(r: S.WatchEnd) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.WatchEnd{+w, +at, +why}:
      K.cat([Watch.journal_kvs(w), [J.kv("ended_at", J.JNum{at}), J.kv("why", J.JStr{why})]])

def WatchEnd.view_json(r: S.WatchEnd) -> J.Json:
  J.obj(WatchEnd.view_kvs(r))

# ---- Out, its journal shape: xid, project, kind, msg, text, state, tries, context, parts ----

def Out.journal_kvs(r: S.Out) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Out{+xid, +project, +kind, +msg, +text, +st, +tries, +context, +parts}:
      K.cat([[J.kv("xid", J.JNum{xid}), J.kv("project", J.JStr{project}), J.kv("kind", J.JStr{XKind.word(kind)}), J.kv("msg", J.JNum{msg}), J.kv("text", J.JStr{text}), J.kv("state", J.JStr{OutSt.word(st)}), J.kv("tries", J.JNum{tries}), J.kv("context", J.JStr{context})], K.omit_s("parts", parts)])

def Out.journal_json(r: S.Out) -> J.Json:
  J.obj(Out.journal_kvs(r))

def Out.journal_of(+j: J.Json) -> S.Out:
  S.Out{rd.n(J.get(j, "xid")), rd.s(J.get(j, "project")), XKind.of_word(rd.s(J.get(j, "kind"))), rd.n(J.get(j, "msg")), rd.s(J.get(j, "text")), OutSt.of_word(rd.s(J.get(j, "state"))), rd.n(J.get(j, "tries")), rd.s(J.get(j, "context")), rd.s(J.get(j, "parts"))}

law Out.journal.xid:
  for +xid: Nat
  for +project: String
  for +kind: S.XKind
  for +msg: Nat
  for +text: String
  for +st: S.OutSt
  for +tries: Nat
  for +context: String
  for +parts: String
  {rd.n(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "xid")) == xid : Nat}

