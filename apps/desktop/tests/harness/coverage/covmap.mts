#!/usr/bin/env node
// The desktop checks' coverage map (fast-try p2; architect m_29198 m_29221 m_29411, review-gates
// m_29412): for every harness check (tests/checks/**.spec.ts), the source files V8 saw run in the
// app while it ran, and the repo files its spec imports. tests/test_map.py desktop-pick is its one
// reader; gate.sh desktop-pick prints a diff's picks. Generated by the nightly, never by hand,
// never committed: <gate dir>/desktop-cov.json, with its sha and date.
//
//   node covmap.mts checks [--gate-dir <d>] [--until <epoch>] [--only <spec>...]
//        the build with source maps (BISE_DESKTOP_SOURCEMAP=1), every check under coverage
//        (hook.js from hook.ts, BISE_HARNESS_COVERAGE) in one heavy slot: the PRODUCT verdict of the night's
//        harness checks (review-gates m_29723): exit 1 and a "FAIL <check>" line per red check;
//        when the coverage hook never took a coverage, the same checks once more without it give
//        the verdict (m_29752: only the map is lost); no report at all is red.
//        --until: the night's end (review-gates m_32494): the specs run BATCH at a time, and no
//        batch starts at or after it; the specs it cut have no verdict (never green), are listed
//        in <gate dir>/desktop-cov-run/cut.txt and go in the map complete:false; exit 3 when some
//        were cut and none ran red (NIGHTLY_NOW: a file holding an epoch, the tests' clock)
//   node covmap.mts map [--gate-dir <d>] [--day YYYY-MM-DD]
//        the map from that run (`write`), then the source maps out of out/ again: a TOOL of the
//        gate (owner try-select), its failure never a product red
//   node covmap.mts run ...        checks, then map (by hand)
//   node covmap.mts write <coverage dir> <playwright json report> [--gate-dir <d>] [--day <d>]
//        this night's map from a run's coverage, then desktop-cov.json: the union of the last 3
//        nights (review-gates #5: one run can miss a branch another takes)
//   node covmap.mts --self-test     the rules below on synthetic coverage (gate.sh quick runs it)
//
// The rules:
//   - a check covers source file F when a source-map segment of F sits at a generated offset whose
//     INNERMOST V8 range has count > 0 (a function of F ran, or F's module code ran). The bundle's
//     top level spans everything at count 1: an outer range never decides (review-gates #2);
//   - a check "loads" every renderer source of every bundle its coverage saw, ran or not (V8 lists a
//     loaded script even when none of it ran): a CSS file applies once its chunk loads, so
//     tests/desktop_assets.py picks a .css by them (pick-assets, review-gates m_34815); the map's
//     "loads" is true only when every night of its union recorded them;
//   - the universe ("files"): every source under src/ with code in a renderer bundle; "shared":
//     every source of the main and preload bundles (tests/test_map.py: ALL);
//   - a check is "complete" only when it ran green, every launch's hook took every target's
//     coverage, and every renderer bundle it ran has a source map; else test_map.py always picks it;
//   - the map refuses to be written when its files are bundles (out/**) instead of src/** or the
//     renderer has no source map (architect m_29221 #3: nothing would ever be skipped, silently).
import { spawnSync } from 'node:child_process';
import { existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const here = path.dirname(fileURLToPath(import.meta.url));
export const DESKTOP = path.resolve(here, '..', '..', '..');
export const REPO = path.resolve(DESKTOP, '..', '..');
const SCHEMA = 1;
const NIGHTS = 3;

// ---- source maps: base64 VLQ (the source map v3 spec)
const B64 = new Map(Array.from('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/').map((c, i) => [c, i]));

/** [genLine, genCol, srcIndex] of every segment that names a source, in order. */
export type Seg = [line: number, col: number, src: number];
export function segments(mappings: string): Seg[] {
  const out: Seg[] = [];
  let src = 0;
  const lines = mappings.split(';');
  for (let line = 0; line < lines.length; line++) {
    let col = 0;
    for (const seg of (lines[line] ?? '').split(',')) {
      if (!seg) continue;
      const v: number[] = [];
      let shift = 0, val = 0;
      for (const c of seg) {
        const d = B64.get(c);
        if (d === undefined) throw new Error(`source map: bad character ${c}`);
        val += (d & 31) << shift;
        if (d & 32) { shift += 5; continue; }
        v.push(val & 1 ? -(val >>> 1) : val >>> 1);
        shift = 0; val = 0;
      }
      col += v[0] ?? 0;
      if (v.length >= 4) {
        src += v[1] ?? 0; // fields 3-4 (the source line and column) are not needed: the file is
        out.push([line, col, src]);
      }
    }
  }
  return out;
}

/** The offset of each line's start in `code` (V8's offsets are UTF-16 indexes, as JS strings). */
export function lineStarts(code: string): number[] {
  const s = [0];
  for (let i = 0; i < code.length; i++) if (code.charCodeAt(i) === 10) s.push(i + 1);
  return s;
}

/**
 * The indexes of the sources that ran: those with a segment whose innermost range has count > 0.
 * functions: V8's FunctionCoverage[] of the script ({ranges: [{startOffset, endOffset, count}]}).
 */
/** V8's FunctionCoverage, the fields read here. */
export type FnCoverage = { ranges: { startOffset: number; endOffset: number; count: number }[] };
export function ranSources(functions: readonly FnCoverage[], segs: readonly Seg[], starts: readonly number[]): Set<number> {
  const ranges: [number, number, number][] = functions.flatMap((f) => f.ranges).map((r) => [r.startOffset, r.endOffset, r.count]);
  // outer first: by start, then the longest; ranges nest or are apart (V8 block coverage)
  ranges.sort((a, b) => a[0] - b[0] || b[1] - a[1]);
  const offs: [number, number][] = segs.map(([l, c, s]): [number, number] => [(starts[l] ?? Infinity) + c, s]).sort((a, b) => a[0] - b[0]);
  const ran = new Set<number>();
  const stack: [number, number, number][] = [];
  const top = () => stack[stack.length - 1];
  let i = 0;
  for (const [o, s] of offs) {
    for (let r = ranges[i]; r && r[0] <= o; r = ranges[i]) {
      while (stack.length && (top()?.[1] ?? 0) <= r[0]) stack.pop();
      stack.push(r);
      i++;
    }
    while (stack.length && (top()?.[1] ?? 0) <= o) stack.pop();
    const inner = stack[stack.length - 1];
    if (inner && inner[2] > 0) ran.add(s);
  }
  return ran;
}

/** A map's sources as repo paths (null: not a repo file: node_modules, a virtual module). */
/** A source map v3 (JSON), the fields read here. */
export type SourceMap = { sources: (string | null)[]; sourceRoot?: string; mappings: string };
export function sourcePaths(map: SourceMap, mapFile: string): (string | null)[] {
  return map.sources.map((s) => {
    if (!s || s.startsWith('\0') || s.includes('\0')) return null;
    // vite's asset imports name the file with a query (composer/emoji.tsv?raw): the file is the source
    const abs = path.resolve(path.dirname(mapFile), map.sourceRoot || '', s.replace(/\?.*$/, ''));
    const rel = path.relative(REPO, abs).split(path.sep).join('/');
    if (rel.startsWith('..') || rel.includes('/node_modules/')) return null;
    return rel;
  });
}

// ---- the bundles of a build (out/): which sources each holds
/** {bundles: {repo path of the js: {kind, sources (repo path|null)[], segs}}, files, shared, faults} */
export type Bundle = { kind: string; sources: (string | null)[] | null; segs: Seg[]; own?: string[]; starts?: number[] };
export type Build = { bundles: Record<string, Bundle>; files: string[]; shared: string[]; faults: string[] };
export function readBuild(outDir: string): Build {
  const bundles: Record<string, Bundle> = {};
  const files = new Set<string>();
  const shared = new Set<string>();
  const faults: string[] = [];
  const walk = (d: string): string[] => (existsSync(d) ? readdirSync(d).flatMap((n) => {
    const p = path.join(d, n);
    return statSync(p).isDirectory() ? walk(p) : [p];
  }) : []);
  for (const kind of ['main', 'preload', 'renderer']) {
    for (const js of walk(path.join(outDir, kind)).filter((p) => /\.(c|m)?js$/.test(p))) {
      const rel = path.relative(REPO, js).split(path.sep).join('/');
      if (!existsSync(js + '.map')) {
        faults.push(`${rel}: no source map (build with BISE_DESKTOP_SOURCEMAP=1)`);
        bundles[rel] = { kind, sources: null, segs: [] };
        continue;
      }
      const map = JSON.parse(readFileSync(js + '.map', 'utf8')) as SourceMap;
      const sources = sourcePaths(map, js + '.map');
      const segs = segments(map.mappings);
      const withCode = new Set(segs.map((s) => s[2]));
      for (const i of withCode) {
        const f = sources[i];
        if (!f || !f.startsWith('apps/desktop/src/')) continue;
        (kind === 'renderer' ? files : shared).add(f);
      }
      // its renderer files: a check that loaded this bundle loaded their CSS (test_map.py's "loads")
      const own = kind === 'renderer' ? [...withCode].map((i) => sources[i]).filter((f): f is string => !!f && f.startsWith('apps/desktop/src/')) : [];
      bundles[rel] = { kind, sources, segs, own, starts: lineStarts(readFileSync(js, 'utf8')) };
    }
  }
  return { bundles, files: [...files].sort(), shared: [...shared].sort(), faults };
}

// ---- one check's coverage
/**
 * One check's coverage folder (<check>/<launch>/{n-target.json, hook.json}) against the build:
 * {ran: Set of repo paths, loads: Set of the repo paths of every renderer bundle it loaded (ran or
 * not: CSS applies once its chunk loads), faults: why it is incomplete}.
 */
/** One take of the hook (JSON): its scripts' coverage. */
type Take = { result?: { url: string; functions: FnCoverage[] }[] };
export type CheckCov = { ran: Set<string>; loads: Set<string>; faults: string[]; launches: number };
export function checkCoverage(dir: string, build: Build): CheckCov {
  const ran = new Set<string>();
  const loads = new Set<string>();
  const faults: string[] = [];
  const launches = existsSync(dir) ? readdirSync(dir).filter((n) => statSync(path.join(dir, n)).isDirectory()) : [];
  for (const l of launches) {
    const ld = path.join(dir, l);
    const hook = path.join(ld, 'hook.json');
    if (!existsSync(hook)) { faults.push(`launch ${l}: no hook.json (the app closed before its coverage was taken)`); continue; }
    const h = JSON.parse(readFileSync(hook, 'utf8')) as { errors?: string[] };
    for (const e of h.errors ?? []) faults.push(`launch ${l}: ${e}`);
    for (const f of readdirSync(ld).filter((n) => n !== 'hook.json' && n.endsWith('.json'))) {
      const take = JSON.parse(readFileSync(path.join(ld, f), 'utf8')) as Take;
      for (const script of take.result ?? []) {
        let rel: string;
        try { rel = path.relative(REPO, fileURLToPath(script.url)).split(path.sep).join('/'); } catch { continue; }
        const b = build.bundles[rel];
        if (!b) continue; // not the app's bundle (the pageapp, a fixture)
        if (!b.sources) { faults.push(`${rel} ran without a source map`); continue; }
        for (const f of b.own ?? []) loads.add(f);
        for (const s of ranSources(script.functions, b.segs, b.starts ?? [])) {
          const f = b.sources[s];
          if (f && f.startsWith('apps/desktop/src/')) ran.add(f);
        }
      }
    }
  }
  return { ran, loads, faults, launches: launches.length };
}

// ---- a spec's imports (TypeScript's own resolution: exact, not a guess)
export function specImports(spec: string, ts: typeof import('typescript')): string[] {
  const cfg = ts.readConfigFile(path.join(DESKTOP, 'tsconfig.node.json'), (p) => ts.sys.readFile(p));
  const opts = ts.parseJsonConfigFileContent(cfg.config, ts.sys, DESKTOP).options;
  const seen = new Set<string>();
  const todo = [path.join(DESKTOP, 'tests', spec)];
  for (let f = todo.pop(); f !== undefined; f = todo.pop()) {
    if (seen.has(f)) continue;
    seen.add(f);
    let text: string;
    try { text = readFileSync(f, 'utf8'); } catch { continue; }
    for (const imp of ts.preProcessFile(text, true, true).importedFiles) {
      const r = ts.resolveModuleName(imp.fileName, f, opts, ts.sys).resolvedModule;
      if (r && !r.isExternalLibraryImport && !r.resolvedFileName.includes('/node_modules/')) todo.push(r.resolvedFileName);
    }
  }
  return [...seen].map((f) => path.relative(REPO, f).split(path.sep).join('/')).filter((f) => !f.startsWith('..')).sort();
}

// ---- the map
/** The specs' results of a playwright JSON report: {checks/...spec.ts: green?}. */
/** Playwright's JSON report, the fields read here. */
export type Suite = { file?: string; specs?: { file?: string; tests?: { status: string }[] }[]; suites?: Suite[] };
export function reportResults(report: { suites?: Suite[] }): Record<string, boolean> {
  const res: Record<string, boolean> = {};
  const walk = (suite: Suite) => {
    for (const spec of suite.specs ?? []) {
      const file = spec.file ?? suite.file;
      if (!file) continue;
      const ok = (spec.tests ?? []).every((t) => ['expected', 'skipped', 'flaky'].includes(t.status));
      res[file] = (res[file] ?? true) && ok;
    }
    for (const s of suite.suites ?? []) walk(s);
  };
  for (const s of report.suites ?? []) walk(s);
  return res;
}

/** The faults that forbid writing a map (architect m_29221 #3), [] when it can be written. */
/** One check in a night's map (desktop-cov/<day>-<sha>.json). */
export type NightCheck = { ran: string[]; loads?: string[]; imports?: string[]; green?: boolean | null; complete?: boolean; why?: string[] };
/** One night's map. */
export type Night = { sha: string; day: string; epoch: number; files: string[]; shared: string[]; checks: Record<string, NightCheck>; loads?: boolean };
export function mapFaults(night: Pick<Night, 'files' | 'shared' | 'checks'>): string[] {
  const f: string[] = [];
  if (!night.files.length) f.push('no source file in the renderer bundles: no source maps?');
  const bad = [...night.files, ...night.shared].filter((x) => !x.startsWith('apps/desktop/src/'));
  if (bad.length) f.push(`bundles instead of source files: ${bad.slice(0, 3).join(', ')}`);
  for (const [c, e] of Object.entries(night.checks)) {
    const b = e.ran.filter((x) => !x.startsWith('apps/desktop/src/'));
    if (b.length) f.push(`${c} covers a bundle, not source files: ${b[0]}`);
  }
  const ranAny = Object.values(night.checks).some((e) => e.ran.length > 0);
  if (Object.keys(night.checks).length && !ranAny) f.push('no check ran any source file: the coverage never reached the renderer');
  return f;
}

/** desktop-cov.json from the last nights (newest first): the newest's files, shared, checks and
 * imports; each check's covered files the union of every night's. */
export function unite(nights: readonly Night[]) {
  const [now] = nights;
  if (!now) throw new Error('covmap: no night to unite');
  const files = now.files;
  const idx = new Map(files.map((f, i) => [f, i]));
  const checks: Record<string, { covered: number[]; loads: number[]; imports?: string[]; complete?: boolean; why?: string[] }> = {};
  for (const [c, e] of Object.entries(now.checks)) {
    const ran = new Set<number>();
    for (const n of nights) for (const f of n.checks[c]?.ran ?? []) { const i = idx.get(f); if (i !== undefined) ran.add(i); }
    const loads = new Set<number>();
    for (const n of nights) for (const f of n.checks[c]?.loads ?? []) { const i = idx.get(f); if (i !== undefined) loads.add(i); }
    checks[c] = { covered: [...ran].sort((a, b) => a - b), loads: [...loads].sort((a, b) => a - b), imports: e.imports, complete: e.complete, why: e.why };
  }
  return {
    schema: SCHEMA, sha: now.sha, day: now.day, epoch: now.epoch,
    // a css picks by loads only when EVERY night of the union has them (review-gates m_34815 #1)
    loads: nights.every((n) => n.loads === true),
    nights: nights.map((n) => ({ sha: n.sha, day: n.day })), files, shared: now.shared, checks,
  };
}

function gateDir(argv: string[]): string {
  const i = argv.indexOf('--gate-dir');
  const given = i >= 0 ? argv[i + 1] : undefined;
  if (given !== undefined) return given;
  if (process.env.BISE_HOME) return path.join(process.env.BISE_HOME, 'gate');
  return existsSync(path.join(os.homedir(), '.bise', 'migrated.json')) ? path.join(os.homedir(), '.bise', 'gate') : '/tmp';
}
const arg = (argv: string[], name: string, dflt: string): string => { const i = argv.indexOf(name); return (i >= 0 ? argv[i + 1] : undefined) ?? dflt; };
const today = () => new Date().toISOString().slice(0, 10);
const git = (...a: string[]) => spawnSync('git', a, { cwd: REPO, encoding: 'utf8' }).stdout.trim();

/** write <coverage dir> <report>: this night's map, then the union of the last nights. */
export async function write(covDir: string, reportFile: string, gdir: string, day: string) {
  const build = readBuild(path.join(DESKTOP, 'out'));
  const ts = (await import('typescript')).default;
  const results = reportResults(JSON.parse(readFileSync(reportFile, 'utf8')) as { suites?: Suite[] });
  const checks: Record<string, NightCheck> = {};
  for (const [spec, green] of Object.entries(results)) {
    if (!spec.startsWith('checks/')) continue;
    const c = checkCoverage(path.join(covDir, spec.split('/').join('__')), build);
    const faults = [...c.faults];
    if (!green) faults.push('red in the map run');
    // a renderer bundle without a source map: its files can't be told (review-gates #4)
    faults.push(...build.faults.filter((f) => f.includes('/renderer/')));
    checks[spec] = { ran: [...c.ran].sort(), loads: [...c.loads].sort(), imports: specImports(spec, ts), green, complete: faults.length === 0, why: faults.slice(0, 3) };
  }
  // the specs the night's end cut (checks' cut.txt): in the map, never complete
  const cutFile = path.join(covDir, 'cut.txt');
  const cut = existsSync(cutFile) ? readFileSync(cutFile, 'utf8').split('\n').filter((s) => s.startsWith('checks/')) : [];
  for (const spec of cut) if (!checks[spec]) checks[spec] = cutCheck(specImports(spec, ts));
  const night: Night = { sha: git('rev-parse', 'HEAD'), day, epoch: Math.floor(Date.now() / 1000), files: build.files, shared: build.shared, checks, loads: true };
  const faults = mapFaults(night);
  if (faults.length) throw new Error(`covmap: no map written: ${faults.join('; ')}`);
  const nd = path.join(gdir, 'desktop-cov');
  mkdirSync(nd, { recursive: true });
  writeFileSync(path.join(nd, `${day}-${night.sha.slice(0, 9)}.json`), JSON.stringify(night));
  const names = readdirSync(nd).filter((n) => /^\d{4}-\d\d-\d\d-[0-9a-f]+\.json$/.test(n)).sort().reverse();
  for (const old of names.slice(NIGHTS * 3)) rmSync(path.join(nd, old), { force: true });
  const nights = names.slice(0, NIGHTS).map((n) => JSON.parse(readFileSync(path.join(nd, n), 'utf8')) as Night);
  const map = unite(nights);
  writeFileSync(path.join(gdir, 'desktop-cov.json.tmp'), JSON.stringify(map));
  renameSync(path.join(gdir, 'desktop-cov.json.tmp'), path.join(gdir, 'desktop-cov.json'));
  // the audit's misses are ALL until the next map: this is the next map
  rmSync(path.join(gdir, 'desktop-pick-all.txt'), { force: true });
  const complete = Object.values(map.checks).filter((e) => e.complete).length;
  console.log(`covmap: ${Object.keys(map.checks).length} checks (${complete} complete), ${map.files.length} files, ${map.shared.length} shared, nights ${map.nights.map((n) => n.day).join(' ')} -> ${path.join(gdir, 'desktop-cov.json')}`);
  return map;
}

/** The specs' names known_reds.txt uses: checks/app/history-perf.spec.ts -> history-perf. */
const redName = (spec: string) => path.basename(spec).replace(/\.spec\.ts$/, '');

/**
 * checks: the build with source maps, then every check under coverage, in one heavy slot. The
 * product's verdict (review-gates m_29723): a red check is a "FAIL <check>" line and exit 1 (the
 * night is red; known_reds.py says which are known); exit 2, no verdict, when the coverage tooling
 * itself never ran (no launch took its coverage): then the checks' results say nothing.
 */
async function runChecks(argv: string[]): Promise<number> {
  const gdir = gateDir(argv);
  const only = argv.includes('--only') ? argv.slice(argv.indexOf('--only') + 1).filter((a) => !a.startsWith('--')) : [];
  const until = Number(arg(argv, '--until', '0')) || 0;
  const late = () => until > 0 && nowEpoch() >= until;
  const covDir = path.join(gdir, 'desktop-cov-run');
  rmSync(covDir, { recursive: true, force: true });
  mkdirSync(covDir, { recursive: true });
  const specs = only.length ? only : listChecks(path.join(DESKTOP, 'tests'));
  const endsAt = until ? new Date(until * 1000).toTimeString().slice(0, 5) : '';
  const cutSay = (cut: readonly string[]) => `${cut.length} not run: cut by the night's end at ${endsAt}, no verdict on them (complete:false in the map)`;
  if (late()) {
    writeFileSync(path.join(covDir, 'cut.txt'), specs.map((s) => s + '\n').join(''));
    console.log(`covmap checks: ${cutSay(specs)}`);
    return 3;
  }
  const electron = harnessElectronEnv(DESKTOP, process.env, os.homedir());
  if (electron.missing) { console.log(`FAIL desktop-checks (${electron.missing})`); return 1; }
  const b = spawnSync('pnpm', ['-s', 'build'], { cwd: DESKTOP, stdio: 'inherit', env: { ...process.env, BISE_DESKTOP_SOURCEMAP: '1' } });
  if (b.status !== 0) { console.log('FAIL desktop-build (pnpm build)'); return 1; }
  const report = path.join(covDir, 'report.json');
  const { heavyArgv } = await import('../heavy.mts');
  const playwright = path.join(DESKTOP, 'node_modules', '.bin', 'playwright');
  // the real-core checks read an ambient-qa world (tests/checks/world.ts): up before the first run
  // when a spec uses it, again before each fresh spec, down at the end, by real.sh's rules
  // (real.json); his keys never reach the run (2026-10-20: no world up, ~86 checks red in ms)
  const real = new RealWorld(specs);
  const baseEnv = real.needed ? scrubKeys(process.env, real.rules.keys) : { ...process.env };
  // one playwright run per batch of specs: the end is checked between batches, never inside one
  const runBatch = (cov: boolean, specsOf: string[], out: string) => {
    const [bin, args] = heavyArgv([playwright, 'test', '-c', path.join(here, '..', 'playwright.config.ts'), '--reporter=list,json', ...specsOf.map((s) => path.join('tests', s))]);
    const t0 = Date.now();
    const env = { ...baseEnv, ...electron.env, PLAYWRIGHT_JSON_OUTPUT_NAME: out, ...(cov ? { BISE_HARNESS_COVERAGE: covDir } : {}) };
    const r = spawnSync(bin, args, { cwd: DESKTOP, stdio: 'inherit', env });
    console.log(`covmap checks${cov ? '' : ' (without coverage)'}: ${specsOf.length} specs, rc ${r.status} in ${Math.round((Date.now() - t0) / 1000)} s`);
  };
  const cut = new Set<string>();
  const run = (cov: boolean, specsOf: string[], out: string) => {
    real.up(baseEnv);
    const r = runBatches(planBatches(specsOf, BATCH, real.rules), late, (batch, i) => {
      if (batch.fresh) real.up(baseEnv);
      const f = path.join(covDir, `${path.basename(out, '.json')}-${i}.json`);
      runBatch(cov, batch.specs, f);
      return f;
    });
    for (const s of r.cut) cut.add(s);
    // one report of every batch's suites; a batch with no report (playwright crashed): no report
    // at all, so the verdict is red as before
    try {
      const suites = r.reports.flatMap((f) => (JSON.parse(readFileSync(f, 'utf8')) as { suites?: Suite[] }).suites ?? []);
      writeFileSync(out, JSON.stringify({ suites }));
    } catch { rmSync(out, { force: true }); }
    return { out, ran: r.ran };
  };
  let v: { red: string[]; said: string };
  try {
    const first = run(true, specs, report);
    v = checksVerdict(covDir, report, () => run(false, first.ran, path.join(covDir, 'report-plain.json')).out);
  } finally {
    real.down(baseEnv);
  }
  const cutList = [...cut].sort();
  writeFileSync(path.join(covDir, 'cut.txt'), cutList.map((s) => s + '\n').join(''));
  for (const s of v.red) console.log(`FAIL ${s}`);
  // the red names, for a release's verdict on this sha (scripts/desktop_tag.py, review-gates m_37177)
  writeFileSync(path.join(covDir, 'reds.txt'), v.red.map((s) => s + '\n').join(''));
  if (v.red.length) spawnSync('python3', [path.join(REPO, 'tests', 'known_reds.py'), 'split', ...v.red], { stdio: 'inherit' });
  console.log(`covmap checks: ${v.said}${cutList.length ? `; ${cutSay(cutList)}` : ''}`);
  return v.red.length ? 1 : cutList.length ? 3 : 0;
}

/**
 * The ambient-qa world the real-core checks read (dev/plugins/ambient-qa/qa.py world up|down, as
 * tests/checks/real.sh: 2 projects, $QA_BISE when set: the nightly hands this tree's own,
 * scripts/tree_bise.sh). Needed only when one of `specs` uses it. A world that doesn't come up is
 * said once here; its checks then fail on their own ('no world up'), at once (BISE_CHECKS_NO_WORLD
 * in `env`, read by world.ts), never hidden.
 */
/** tests/checks/real.json: the world's run rules (real.sh's too). */
export type RealRules = { first: string[]; fresh: string[]; keys: string };
type Env = NodeJS.ProcessEnv;
class RealWorld {
  readonly rules: RealRules;
  readonly needed: boolean;
  constructor(specs: readonly string[]) {
    this.rules = JSON.parse(readFileSync(path.join(DESKTOP, 'tests', 'checks', 'real.json'), 'utf8')) as RealRules;
    this.needed = specs.some((s) => usesWorld(readFileSync(path.join(DESKTOP, 'tests', s), 'utf8')));
  }

  qa(args: string[], env: Env) {
    return spawnSync('python3', ['-B', path.join(REPO, 'dev', 'plugins', 'ambient-qa', 'qa.py'), 'world', ...args],
      { cwd: REPO, encoding: 'utf8', env });
  }

  up(env: Env) {
    if (!this.needed) return;
    this.down(env);
    const t0 = Date.now();
    const r = this.qa(['up', '--projects', '2', ...(env.QA_BISE ? ['--bise', env.QA_BISE] : [])], env);
    const s = Math.round((Date.now() - t0) / 1000);
    // a world that didn't come up: its checks fail at once on BISE_CHECKS_NO_WORLD (world.ts), never
    // each one waiting out its qa.py call and its timeout (d39283a86's run: 24 reds in 4 h 40)
    delete env.BISE_CHECKS_NO_WORLD;
    if (r.status === 0) console.log(`covmap checks: the real-core world is up (${s} s)`);
    else {
      env.BISE_CHECKS_NO_WORLD = `qa.py world up exit ${r.status}`;
      // r.error: python3 didn't start (no output then)
      const tail = (r.error ? r.error.message : `${r.stdout}${r.stderr}`).trim().split(os.EOL).slice(-20).join(os.EOL);
      console.log(`covmap checks: the real-core world didn't come up (exit ${r.status}, ${s} s): its checks fail 'no world up'`);
      console.log(tail);
    }
  }

  down(env: Env) {
    if (this.needed) this.qa(['down'], env);
  }
}

/** Specs per playwright run: the night's end is checked between two runs, so a run started just
 * before it ends at most ~BATCH x 20 s later; each run costs a playwright start (a few s). */
const BATCH = 8;

/** The clock: NIGHTLY_NOW (a file holding an epoch, the tests' clock), else now, in seconds. */
function nowEpoch() {
  if (process.env.NIGHTLY_NOW) return Number(readFileSync(process.env.NIGHTLY_NOW, 'utf8').trim());
  return Math.floor(Date.now() / 1000);
}

/** Every check spec under <tests>/checks, as 'checks/...spec.ts', sorted. */
export function listChecks(testsDir: string): string[] {
  const walk = (d: string): string[] => (existsSync(d) ? readdirSync(d).sort().flatMap((n) => {
    const p = path.join(d, n);
    return statSync(p).isDirectory() ? walk(p) : n.endsWith('.spec.ts') ? [p] : [];
  }) : []);
  return walk(path.join(testsDir, 'checks')).map((p) => path.relative(testsDir, p).split(path.sep).join('/'));
}

/**
 * specs in batches of `size`, in order: before each batch, late() true cuts it and every batch
 * after it (nothing new starts past the night's end; the batch running then ends). runOne(batch,
 * i) runs one and returns its report file. {ran, cut, reports}.
 */
export type Batch = { specs: string[]; fresh: boolean };
export function runBatches(batches: readonly Batch[], late: () => boolean, runOne: (batch: Batch, i: number) => string) {
  const ran: string[] = [];
  const cut: string[] = [];
  const reports: string[] = [];
  batches.forEach((batch, i) => {
    if (cut.length || late()) { cut.push(...batch.specs); return; }
    reports.push(runOne(batch, i));
    ran.push(...batch.specs);
  });
  return { ran, cut, reports };
}

/** `specs` in runs of at most `size`, in order: [{specs, fresh:false}]. Pure. */
export function chunks(specs: readonly string[], size: number): Batch[] {
  const out: Batch[] = [];
  for (let i = 0; i < specs.length; i += size) out.push({ specs: specs.slice(i, i + size), fresh: false });
  return out;
}

/**
 * The runs of a checks run, in order, by the real-core world's rules (tests/checks/real.json, the
 * ones real.sh follows): the `first` specs in a run of their own, then the rest by path BATCH at a
 * time, then each `fresh` spec alone, on a fresh world (fresh:true). Pure.
 */
export function planBatches(specs: readonly string[], size: number, rules: Pick<RealRules, 'first' | 'fresh'>): Batch[] {
  const first = specs.filter((s) => rules.first.includes(s));
  const fresh = specs.filter((s) => rules.fresh.includes(s) && !first.includes(s));
  const rest = specs.filter((s) => !first.includes(s) && !fresh.includes(s));
  return [...(first.length ? [{ specs: first, fresh: false }] : []), ...chunks(rest, size), ...fresh.map((s) => ({ specs: [s], fresh: true }))];
}

/** Whether a spec's source runs on the real-core world (it imports tests/checks/world.ts). Pure. */
export const usesWorld = (src: string) => /from '(?:\.\.?\/)+world'/.test(src);

/** `env` without his keys (real.json's `keys`, as real.sh's scrub), one fake Mistral key in. Pure. */
export function scrubKeys(env: Env, keys: string): Env {
  const re = new RegExp(keys, 'i');
  const out = Object.fromEntries(Object.entries(env).filter(([k]) => !re.test(k)));
  return { ...out, MISTRAL_API_KEY: 'qa-fake-not-a-key' };
}

/** A check the night's end cut: no verdict tonight (green null), complete:false so test_map.py's
 * desktop-pick always picks it until a night runs it; its covered files stay the older nights'. */
export function cutCheck(imports: string[]): NightCheck {
  return { ran: [], loads: [], imports, green: null, complete: false, why: ['not run tonight: cut by the night\'s end'] };
}

/**
 * The Electron the harness launches (tests/harness/electron.ts), for a tree whose node_modules came
 * without its binary (gate.sh installs with ELECTRON_SKIP_BINARY_DOWNLOAD: the nightly tree): the
 * caller's BISE_HARNESS_ELECTRON_DIST, else the tree's own dist or patched clone, else the shared
 * patched copy ~/.bise/dev/electron-dist/v<version>-lsui. {env} to add, or {missing: why}.
 */
export function harnessElectronEnv(desktop: string, env: Env, home: string): { env: Record<string, string>; missing?: undefined } | { env?: undefined; missing: string } {
  if (env.BISE_HARNESS_ELECTRON_DIST) return { env: {} };
  let version = '';
  try { version = (JSON.parse(readFileSync(path.join(desktop, 'node_modules', 'electron', 'package.json'), 'utf8')) as { version: string }).version; } catch { /* no electron */ }
  if (!version) return { missing: 'no node_modules/electron: pnpm install first' };
  const app = (d: string) => existsSync(path.join(d, 'Electron.app', 'Contents', 'MacOS', 'Electron'));
  if (app(path.join(desktop, 'node_modules', 'electron', 'dist')) || app(path.join(desktop, '.harness-cache', `electron-${version}`))) return { env: {} };
  const shared = path.join(home, '.bise', 'dev', 'electron-dist', `v${version}-lsui`);
  if (app(shared)) return { env: { BISE_HARNESS_ELECTRON_DIST: shared } };
  return { missing: `no Electron ${version}: not in node_modules/electron/dist, .harness-cache, nor ${shared} (tests/harness/README.md 'Electron')` };
}

/** Whether a coverage run's launches took their coverage (a hook.json): false = the tooling broke. */
export function hookRan(covDir: string): boolean {
  const dirs = existsSync(covDir) ? readdirSync(covDir).filter((n) => n.startsWith('checks__')) : [];
  return dirs.length === 0 || dirs.some((d) => readdirSync(path.join(covDir, d)).some((l) => existsSync(path.join(covDir, d, l, 'hook.json'))));
}

/**
 * The night's product verdict on the checks (review-gates m_29723, m_29752): the red checks (by
 * known_reds' names), from the coverage run's report; when the hook never took a coverage, from
 * one run of the same checks without coverage (rerunPlain() -> its report): only the map is lost.
 * No report at all is red too: these checks run nowhere else at night.
 */
export function checksVerdict(covDir: string, report: string, rerunPlain: () => string): { red: string[]; said: string } {
  let from = report;
  let note = '';
  if (!hookRan(covDir)) {
    from = rerunPlain();
    note = ' (the coverage hook never took a coverage: this is the run without coverage; no map tonight)';
  }
  let results: Record<string, boolean>;
  try { results = reportResults(JSON.parse(readFileSync(from, 'utf8')) as { suites?: Suite[] }); } catch {
    return { red: ['desktop-checks'], said: `no playwright report (${from}): red, no verdict on the checks${note}` };
  }
  const specs = Object.keys(results).filter((x) => x.startsWith('checks/'));
  const red = specs.filter((x) => !results[x]).map(redName);
  return { red, said: `${specs.length - red.length}/${specs.length} green${note}` };
}

/** map: the map from the last checks run (desktop-cov-run), then no source map left in out/. */
async function runMap(argv: string[]) {
  const gdir = gateDir(argv);
  const covDir = path.join(gdir, 'desktop-cov-run');
  try {
    await write(covDir, path.join(covDir, 'report.json'), gdir, arg(argv, '--day', today()));
  } finally {
    // pnpm build and a release ship no source map: none left in out/
    for (const k of ['main', 'preload', 'renderer']) {
      const walk = (d: string): string[] => (existsSync(d) ? readdirSync(d).flatMap((n) => { const p = path.join(d, n); return statSync(p).isDirectory() ? walk(p) : [p]; }) : []);
      for (const m of walk(path.join(DESKTOP, 'out', k)).filter((p) => p.endsWith('.map'))) rmSync(m);
    }
  }
}

// ---- the self-test: synthetic coverage, no app (review-gates #2: nested ranges)
export function selfTest() {
  const assert = (ok: unknown, what: string) => { if (!ok) throw new Error(`covmap self-test: ${what}`); };
  // VLQ: "AAAA" = col 0 src 0 line 0 col 0; "IAAA" = col +4; ",ECAA" next source
  const segs = segments('AAAA,IAAA,ECAA;AAAA');
  assert(JSON.stringify(segs) === JSON.stringify([[0, 0, 0], [0, 4, 0], [0, 6, 1], [1, 0, 1]]), `segments ${JSON.stringify(segs)}`);
  assert(segments('A;;C').length === 0, 'a 1-field segment names no source');
  // a bundle "a();function b(){}c" : source 0 = a (0..3), source 1 = b's body (4..18), source 2 = c (18)
  //   top level 0..19 count 1; function b 4..18 count 0
  const starts = [0];
  const top: FnCoverage = { ranges: [{ startOffset: 0, endOffset: 19, count: 1 }] };
  const fns: FnCoverage[] = [top, { ranges: [{ startOffset: 4, endOffset: 18, count: 0 }] }];
  const bundle: Seg[] = [[0, 0, 0], [0, 4, 1], [0, 10, 1], [0, 18, 2]];
  let ran = ranSources(fns, bundle, starts);
  assert(ran.has(0) && !ran.has(1) && ran.has(2), `innermost: b never ran inside a top level that did (${[...ran].join(',')})`);
  // b ran, but a block inside it (10..14) didn't: b still ran (its segment at 4)
  ran = ranSources([top, { ranges: [{ startOffset: 4, endOffset: 18, count: 2 }, { startOffset: 10, endOffset: 14, count: 0 }] }], bundle, starts);
  assert(ran.has(1), 'a function that ran with a cold block');
  // only the cold block maps to source 3: not covered
  ran = ranSources([top, { ranges: [{ startOffset: 4, endOffset: 18, count: 2 }, { startOffset: 10, endOffset: 14, count: 0 }] }], [[0, 11, 3]], starts);
  assert(!ran.has(3), 'a segment in a block that never ran');
  // a constants-only module: its code is top level, which ran
  ran = ranSources(fns, [[0, 1, 5]], starts);
  assert(ran.has(5), 'a constants-only module ran with the top level');
  // apart siblings, the second one ran
  ran = ranSources([top, { ranges: [{ startOffset: 2, endOffset: 5, count: 0 }] }, { ranges: [{ startOffset: 6, endOffset: 9, count: 1 }] }], [[0, 3, 0], [0, 7, 1]], starts);
  assert(!ran.has(0) && ran.has(1), 'siblings');
  // lines
  assert(JSON.stringify(lineStarts('ab\ncd\n')) === '[0,3,6]', 'lineStarts');
  ran = ranSources([{ ranges: [{ startOffset: 3, endOffset: 5, count: 1 }] }], [[1, 1, 0]], lineStarts('ab\ncd\n'));
  assert(ran.has(0), 'a segment on line 2');
  // the harness's Electron in a tree installed without its binary (the nightly's)
  const et = mkdtempSync(path.join(os.tmpdir(), 'covmap-e-'));
  try {
    const d = path.join(et, 'desktop');
    const mk = (dir: string) => { mkdirSync(path.join(dir, 'Electron.app', 'Contents', 'MacOS'), { recursive: true }); writeFileSync(path.join(dir, 'Electron.app', 'Contents', 'MacOS', 'Electron'), ''); };
    assert(harnessElectronEnv(d, {}, et).missing?.includes('pnpm install'), 'no electron package');
    mkdirSync(path.join(d, 'node_modules', 'electron'), { recursive: true });
    writeFileSync(path.join(d, 'node_modules', 'electron', 'package.json'), '{"version":"9.9.9"}');
    assert(harnessElectronEnv(d, {}, et).missing?.includes('no Electron 9.9.9'), 'no binary anywhere: missing');
    assert(Object.keys(harnessElectronEnv(d, { BISE_HARNESS_ELECTRON_DIST: '/x' }, et).env ?? { missing: 1 }).length === 0, 'the caller\'s wins');
    mk(path.join(et, '.bise', 'dev', 'electron-dist', 'v9.9.9-lsui'));
    assert(harnessElectronEnv(d, {}, et).env?.BISE_HARNESS_ELECTRON_DIST === path.join(et, '.bise', 'dev', 'electron-dist', 'v9.9.9-lsui'), 'the shared copy');
    mk(path.join(d, 'node_modules', 'electron', 'dist'));
    assert(Object.keys(harnessElectronEnv(d, {}, et).env ?? { missing: 1 }).length === 0, 'the tree\'s own dist');
  } finally {
    rmSync(et, { recursive: true, force: true });
  }
  // a vite asset import's query: the file itself
  const sp = sourcePaths({ mappings: '', sources: ['../../src/composer/emoji.tsv?raw', '\0vite/preload', '../../node_modules/react/index.js'] }, path.join(DESKTOP, 'out', 'renderer', 'x.js.map'));
  assert(sp[0] === 'apps/desktop/src/composer/emoji.tsv' && sp[1] === null && sp[2] === null, `sourcePaths ${JSON.stringify(sp)}`);
  // the whole-bundle guard (architect m_29221 #3)
  const ok = { files: ['apps/desktop/src/a.tsx'], shared: [], checks: { 'checks/x.spec.ts': { ran: ['apps/desktop/src/a.tsx'] } } };
  assert(mapFaults(ok).length === 0, 'a good night');
  assert(mapFaults({ ...ok, files: [] }).length === 1, 'no source file');
  assert(mapFaults({ ...ok, files: ['apps/desktop/out/renderer/assets/index.js'] }).some((f) => f.includes('bundles')), 'files are bundles');
  assert(mapFaults({ ...ok, checks: { 'checks/x.spec.ts': { ran: ['apps/desktop/out/renderer/assets/index.js'] } } }).some((f) => f.includes('covers a bundle')), 'a check covers a bundle');
  assert(mapFaults({ ...ok, checks: { 'checks/x.spec.ts': { ran: [] } } }).some((f) => f.includes('never reached')), 'no check ran anything');
  // the union of the nights: the newest's files, every night's coverage of them
  const n1 = { sha: 'b', day: '2026-10-18', epoch: 2, files: ['f1', 'f2'], shared: ['s'], checks: { c: { ran: ['f1'], imports: ['i'], complete: true } } };
  const n2 = { sha: 'a', day: '2026-10-17', epoch: 1, files: ['f1', 'f2', 'gone'], shared: [], checks: { c: { ran: ['f2', 'gone'] }, old: { ran: ['f1'] } } };
  const m = unite([n1, n2]);
  assert(!m.loads && JSON.stringify(m.checks.c?.loads) === '[]', 'nights without loads: the map has no loads');
  const l1 = { ...n1, loads: true, checks: { c: { ran: ['f1'], loads: ['f1'], imports: ['i'], complete: true } } };
  const l2 = { ...n2, loads: true, checks: { c: { ran: ['f2'], loads: ['f2', 'gone'] } } };
  let lm = unite([l1, l2]);
  assert(lm.loads && JSON.stringify(lm.checks.c?.loads) === '[0,1]', `loads: the union of the nights ${JSON.stringify(lm)}`);
  lm = unite([l1, l2, n2]);
  assert(!lm.loads, 'one night of the union without loads: the map has no loads');
  assert(JSON.stringify(m.checks.c?.covered) === '[0,1]' && !m.checks.old && m.sha === 'b' && m.day === '2026-10-18' && m.nights.length === 2, `unite ${JSON.stringify(m)}`);
  // the night's end (review-gates m_32494): checked between batches only; what it cuts never runs
  let clock = 0;
  const started: string[] = [];
  const rb = runBatches(chunks(['a', 'b', 'c', 'd', 'e'], 2), () => clock >= 10, (batch, i) => { started.push(batch.specs.join()); clock += 6; return `r${i}`; });
  assert(started.join('|') === 'a,b|c,d' && rb.ran.join() === 'a,b,c,d' && rb.cut.join() === 'e' && rb.reports.join() === 'r0,r1', `batches cut at the end ${JSON.stringify(rb)}`);
  const none = runBatches(chunks(['a', 'b'], 8), () => true, () => { throw new Error('ran past the end'); });
  assert(none.ran.length === 0 && none.cut.join() === 'a,b' && none.reports.length === 0, 'past the end: nothing runs');
  const all = runBatches(chunks(['a', 'b', 'c'], 2), () => false, (_b, i) => `r${i}`);
  assert(all.cut.length === 0 && all.ran.join() === 'a,b,c', 'no end: every batch');
  // the real-core world's rules (real.json, real.sh's): first alone, the rest by path, each fresh
  // spec last and alone on a fresh world
  const rules = { first: ['n'], fresh: ['f1', 'f2'] };
  const plan = planBatches(['a', 'f1', 'b', 'n', 'c', 'f2'], 2, rules);
  assert(JSON.stringify(plan) === JSON.stringify([{ specs: ['n'], fresh: false }, { specs: ['a', 'b'], fresh: false }, { specs: ['c'], fresh: false },
    { specs: ['f1'], fresh: true }, { specs: ['f2'], fresh: true }]), `the world's order ${JSON.stringify(plan)}`);
  assert(JSON.stringify(planBatches(['a', 'b'], 8, rules)) === JSON.stringify([{ specs: ['a', 'b'], fresh: false }]), 'no real spec: plain batches');
  const shipped = JSON.parse(readFileSync(path.join(DESKTOP, 'tests', 'checks', 'real.json'), 'utf8')) as RealRules;
  const listed = listChecks(path.join(DESKTOP, 'tests'));
  assert([...shipped.first, ...shipped.fresh].every((s) => listed.includes(s)), `real.json names checks that exist: ${JSON.stringify(shipped)}`);
  assert(usesWorld("import { realWorld } from '../world';") && usesWorld("from './world'") && !usesWorld("from '../harness'"), 'usesWorld: an import of checks/world.ts');
  assert(listed.some((s) => usesWorld(readFileSync(path.join(DESKTOP, 'tests', s), 'utf8'))), 'the real-core checks are seen (a full run brings the world up)');
  const sc = scrubKeys({ PATH: '/bin', OPENAI_API_KEY: 'sk', GH_TOKEN: 'g', MISTRAL_API_KEY: 'real', AWS_REGION: 'x', HOME: '/h' }, shipped.keys);
  assert(JSON.stringify(sc) === JSON.stringify({ PATH: '/bin', HOME: '/h', MISTRAL_API_KEY: 'qa-fake-not-a-key' }), `no key of his reaches the run: ${JSON.stringify(sc)}`);
  // a cut check: no verdict, never complete, its covered files the older nights'
  const cn = { ...n1, checks: { c: cutCheck(['i']) } };
  const cm = unite([cn, { ...n1, sha: 'z', checks: { c: { ran: ['f2'], complete: true } } }]);
  assert(cm.checks.c?.complete === false && JSON.stringify(cm.checks.c.covered) === '[1]' && cn.checks.c.green === null, `a cut check in the map ${JSON.stringify(cm.checks.c)}`);
  // the report: a spec red in any of its tests is red
  const res = reportResults({ suites: [{ file: 'checks/a.spec.ts', specs: [{ tests: [{ status: 'expected' }] }, { tests: [{ status: 'unexpected' }] }] }, { file: 'checks/b.spec.ts', specs: [{ tests: [{ status: 'flaky' }] }] }] });
  assert(res['checks/a.spec.ts'] === false && res['checks/b.spec.ts'] === true, `report ${JSON.stringify(res)}`);
  // the product verdict (review-gates m_29752): a broken hook falls back to a run without coverage
  const tmp = mkdtempSync(path.join(os.tmpdir(), 'covmap-'));
  try {
    const rep = (file: string, red: boolean) => { writeFileSync(file, JSON.stringify({ suites: [{ file: 'checks/app/keep.spec.ts', specs: [{ tests: [{ status: red ? 'unexpected' : 'expected' }] }] }] })); return file; };
    const launch = (hook: boolean) => { const d = path.join(tmp, 'cov', 'checks__app__keep.spec.ts', '1'); mkdirSync(d, { recursive: true }); rmSync(path.join(d, 'hook.json'), { force: true }); if (hook) writeFileSync(path.join(d, 'hook.json'), '{}'); };
    const cov = path.join(tmp, 'cov');
    let plain = 0;
    const rerun = (red: boolean) => () => { plain += 1; return rep(path.join(tmp, 'plain.json'), red); };
    launch(true);
    let v = checksVerdict(cov, rep(path.join(tmp, 'r.json'), true), rerun(false));
    assert(v.red.join() === 'keep' && plain === 0, `a red check under coverage: ${JSON.stringify(v)}`);
    v = checksVerdict(cov, rep(path.join(tmp, 'r.json'), false), rerun(true));
    assert(v.red.length === 0 && plain === 0, 'green under coverage');
    launch(false);
    v = checksVerdict(cov, rep(path.join(tmp, 'r.json'), false), rerun(true));
    assert(v.red.join() === 'keep' && plain === 1 && v.said.includes('without coverage'), `the hook broke, a check red without coverage: ${JSON.stringify(v)}`);
    v = checksVerdict(cov, path.join(tmp, 'none.json'), rerun(false));
    assert(v.red.join() === 'keep' || plain === 2, 'the hook broke: the plain run decides');
    launch(true);
    v = checksVerdict(cov, path.join(tmp, 'none.json'), rerun(false));
    assert(v.red.join() === 'desktop-checks', `no report: red (${JSON.stringify(v)})`);
  } finally {
    rmSync(tmp, { recursive: true, force: true });
  }
  console.log('covmap self-test: ok');
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const argv = process.argv.slice(2);
  try {
    if (argv[0] === '--self-test') selfTest();
    else if (argv[0] === 'checks') process.exit(await runChecks(argv));
    else if (argv[0] === 'map') await runMap(argv);
    else if (argv[0] === 'run') { const v = await runChecks(argv); if (v !== 2) await runMap(argv); process.exit(v); }
    else if (argv[0] === 'write' && argv[1] && argv[2]) await write(argv[1], argv[2], gateDir(argv), arg(argv, '--day', today()));
    else { console.error('usage: covmap.mts checks|map|run [--gate-dir d] [--day d] [--only spec...] | write <cov dir> <report.json> [--gate-dir d] | --self-test'); process.exit(2); }
  } catch (e) {
    console.error(e instanceof Error ? e.message : String(e));
    process.exit(1);
  }
}
