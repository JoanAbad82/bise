<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- bise desktop's hardened runtime entitlements (scripts/desktop_sign.py): on the app, Electron's
     helper apps and every bare executable it carries (bise, repl-live, sb-core, bend-jsrt,
     bise-mac-helper); never on a library. JIT: V8 in Electron and in bend-jsrt. audio-input: the
     fn dictation. apple-events: the address of the tab in front. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
