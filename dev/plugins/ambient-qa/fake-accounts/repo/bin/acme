#!/usr/bin/env python3
"""acme: the command line for acme (login, sync, ask)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from acme import sync  # noqa: E402


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: acme login | acme sync | acme ask <question>")
        return 0
    if argv[0] == "sync":
        token = os.environ.get("ACME_TOKEN", "")
        print("synced %d plans" % sync.sync(token))
        return 0
    print("acme: unknown command %s" % argv[0], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
