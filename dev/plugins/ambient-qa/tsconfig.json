{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "typeRoots": ["../../../apps/desktop/node_modules/@types"],
    "types": ["node"],
    "paths": { "@playwright/test": ["../../../apps/desktop/node_modules/@playwright/test"] },
    "strict": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["pagedrive.ts", "as-he-does/*.ts"]
}
