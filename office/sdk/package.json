{
  "name": "@bise/office",
  "private": true,
  "version": "0.1.0",
  "description": "bise's office SDK: read, create and edit xlsx, pptx and docx, bytes in and bytes out (docs/office.md)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "main": "../dist/office.js",
  "scripts": {
    "build": "node build.ts",
    "build:check": "node build.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm build:check && pnpm test"
  },
  "dependencies": {
    "@univerjs/core": "1.1.0",
    "@univerjs/engine-formula": "1.1.0",
    "@univerjs/preset-sheets-core": "1.1.0",
    "@univerjs/themes": "1.1.0",
    "@xmldom/xmldom": "0.9.12",
    "docx-preview": "0.4.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "jszip": "3.10.2",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "pdfjs-dist": "6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "saxes": "5.0.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
